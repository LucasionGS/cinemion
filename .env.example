#####################
# Server
#####################
# Port Cinemion listens on (web UI and API).
PORT=8600
# Public address when Cinemion is behind a reverse proxy, e.g. https://cinemion.example.com. Leave empty on a LAN.
SITE_URL=
# development or production. In development the server proxies the Vite dev server.
APP_ENV=development
# Vite dev server the backend proxies to in development.
VITE_DEV_URL=http://localhost:5173

#####################
# Folders
#####################
# Database, settings, artwork and profile pictures. Defaults to ~/.cinemion (or /config in Docker).
CONFIG_DIR=
# Conversion segments and seek thumbnails. Defaults to <CONFIG_DIR>/cache (or /cache in Docker).
CACHE_DIR=
# Folders the library folder browser may show, separated by ":". Defaults to your home folder (or /media in Docker).
MEDIA_ROOTS=
# Where uploads from the browser are kept while they come in. Defaults to <CACHE_DIR>/uploads. A folder on the same
# drive as your libraries makes finished uploads move into place instantly instead of being copied.
UPLOAD_DIR=
# Largest file that can be uploaded from the browser, in GB. 0 = no limit (only the free disk space counts).
UPLOAD_MAX_GB=0

#####################
# Database
#####################
# sqlite (default, a file in CONFIG_DIR) or mariadb.
DB_DIALECT=sqlite
# Only used for mariadb.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinemion
DB_USER=cinemion
DB_PASSWORD=
# Run pending migrations on startup.
AUTO_MIGRATE=true

#####################
# Security
#####################
# Secret for signing login tokens. Generated and stored in CONFIG_DIR on first start when empty.
JWT_SECRET=

#####################
# Tools
#####################
# Paths to ffmpeg and ffprobe. Defaults to the ones on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

#####################
# Online services
#####################
# TMDB API key (v3 key or v4 read token), used when none is set in Settings › Metadata. Without either, Cinemion uses
# the key built into it.
TMDB_API_KEY=
# TheTVDB project API key and, for keys that come with a subscription, the subscriber PIN. Used when none is set in
# Settings › Metadata.
TVDB_API_KEY=
TVDB_PIN=
# OMDb API key for IMDb, Rotten Tomatoes and Metacritic ratings, used when none is set in Settings › Metadata.
OMDB_API_KEY=
# SteamGridDB API key (free, from your SteamGridDB preferences) for games in Clips libraries that aren't on Steam, used
# when none is set in Settings › Metadata.
STEAMGRIDDB_API_KEY=
# Trakt app keys (make an app at https://trakt.tv/oauth/applications with redirect URI urn:ietf:wg:oauth:2.0:oob),
# used when none are set in Settings › Integrations. Each profile links its own account in Settings › Your profile.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# OpenSubtitles API key for subtitle search, used when none is set in Settings › Subtitles.
OPENSUBTITLES_API_KEY=
# OpenSubtitles API address. Only change it for the VIP endpoint (https://vip-api.opensubtitles.com/api/v1).
OPENSUBTITLES_API_URL=https://api.opensubtitles.com/api/v1
# SubDL API key (free, from your account on subdl.com), used when none is set in Settings › Subtitles.
SUBDL_API_KEY=
# Look on GitHub twice a day for a newer Cinemion and tell admins about it. false turns it off for good (it can also
# be turned off in Settings › About).
UPDATE_CHECK=true
