#####################
# Server
#####################
# Port Cinemion listens on (web UI and API).
PORT=8600
# Public address when Cinemion is behind a reverse proxy, e.g. https://cinemion.example.com. Leave empty on a LAN.
SITE_URL=
# development or production. In development the server proxies the Vite dev server.
APP_ENV=development
# Vite dev server the backend proxies to in development.
VITE_DEV_URL=http://localhost:5173

#####################
# Folders
#####################
# Database, settings, artwork and profile pictures. Defaults to ~/.cinemion (or /config in Docker).
CONFIG_DIR=
# Conversion segments and seek thumbnails. Defaults to <CONFIG_DIR>/cache (or /cache in Docker).
CACHE_DIR=
# Folders the library folder browser may show, separated by ":". Defaults to your home folder (or /media in Docker).
MEDIA_ROOTS=

#####################
# Database
#####################
# sqlite (default, a file in CONFIG_DIR) or mariadb.
DB_DIALECT=sqlite
# Only used for mariadb.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinemion
DB_USER=cinemion
DB_PASSWORD=
# Run pending migrations on startup.
AUTO_MIGRATE=true

#####################
# Security
#####################
# Secret for signing login tokens. Generated and stored in CONFIG_DIR on first start when empty.
JWT_SECRET=

#####################
# Tools
#####################
# Paths to ffmpeg and ffprobe. Defaults to the ones on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

#####################
# Online services
#####################
# TMDB API key (v3 key or v4 read token), used when none is set in Settings › Metadata.
TMDB_API_KEY=
# OpenSubtitles API key for subtitle search, used when none is set in Settings › Subtitles.
OPENSUBTITLES_API_KEY=
# OpenSubtitles API address. Only change it for the VIP endpoint (https://vip-api.opensubtitles.com/api/v1).
OPENSUBTITLES_API_URL=https://api.opensubtitles.com/api/v1
