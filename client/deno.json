{
  "name": "@cinemion/client",
  "version": "0.4.0",
  "exports": "./src/main.tsx",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "strict": true
  },
  "imports": {
    "@shared/": "../shared/src/",
    "react": "npm:react@^19.2.0",
    "react/": "npm:/react@^19.2.0/",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-dom/": "npm:/react-dom@^19.2.0/",
    "@types/react": "npm:@types/react@^19.2.0",
    "@types/react-dom": "npm:@types/react-dom@^19.2.0",
    "@base-ui/react": "npm:@base-ui/react@^1.8.0",
    "@base-ui/react/": "npm:/@base-ui/react@^1.8.0/",
    "lucide-react": "npm:lucide-react@^1.50.0",
    "hls.js": "npm:hls.js@^1.7.3",
    "jassub": "npm:jassub@2.5.18",
    "vite": "npm:vite@^8.3.0",
    "@vitejs/plugin-react-swc": "npm:@vitejs/plugin-react-swc@^4.3.3",
    "sass": "npm:sass@^1.100.0",
    "@fontsource-variable/sora": "npm:@fontsource-variable/sora@^5.2.0",
    "@fontsource-variable/manrope": "npm:@fontsource-variable/manrope@^5.2.0"
  }
}
